        "gc_address": {"desc": "사업장 주소", "example": "○○시 ○○로 00"},
        "gc_email": {"desc": "대표 이메일(바닥글)", "example": "hello@example.com"},
        "gc_area": {"desc": "서비스 지역 소개 문장", "example": "○○시 전 지역 · 인근 산업단지"},
        "gc_notify_email": {"desc": "새 견적 문의를 받을 메일 주소", "example": "owner@example.com"}

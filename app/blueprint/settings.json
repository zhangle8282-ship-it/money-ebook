        "gc_reviews": {"desc": "고객 후기 JSON: [[후기 글, 누가] …]", "example": "[[\"꼼꼼하게 해 주셨어요.\",\"○○사무실 담당자\"]]"},
        "gc_home_updated": {"desc": "첫 화면을 마지막으로 고친 시각(사이트맵 날짜)", "example": "2026-01-01 09:00:00"}

        "gc_phone": {"desc": "대표 전화번호(머리글 · 바닥글 · 문의 완료 안내)", "example": "010-0000-0000"},
        "gc_kakao_url": {"desc": "카카오톡 채널 주소", "example": "https://pf.kakao.com/_example"},
        "gc_channeltalk_key": {"desc": "채널톡 플러그인 키(넣으면 채팅 상담 버튼)", "example": "", "secret": true},
        "gc_owner": {"desc": "대표자 이름(바닥글 사업자 정보)", "example": "홍길동"},
        "gc_biz_number": {"desc": "사업자등록번호", "example": "000-00-00000"},
        "gc_biz_type": {"desc": "업태", "example": "서비스"},
